    userId,
    chatId: `chat-${Date.now()}`,
    name: 'Test Component',
    html: '<div>Test HTML</div>',
    hideFromLibrary: false,
    ...overrides
  };
  
  return await createComponent(componentData);
};
```

## Configuration Files

### Drizzle Configuration
[drizzle.config.ts](mdc:backend/drizzle.config.ts):
```typescript
import type { Config } from "drizzle-kit";

export default {
  schema: "./src/schema.ts",
  out: "./drizzle",
  driver: "better-sqlite",
  dbCredentials: {
    url: "./imperial.db"
  }
} satisfies Config;
```

### Migration Script
[migration.js](mdc:backend/migration.js):
```javascript
const { migrate } = require("drizzle-orm/better-sqlite3/migrator");
const { drizzle } = require("drizzle-orm/better-sqlite3");
const Database = require("better-sqlite3");

const sqlite = new Database("imperial.db");
const db = drizzle(sqlite);

migrate(db, { migrationsFolder: "./drizzle" });
```

## Best Practices

### Schema Design
1. **Naming**: Use camelCase for columns, PascalCase for tables
2. **Types**: Prefer specific types over generic ones
3. **Constraints**: Add appropriate constraints (unique, not null, foreign keys)
4. **Indexes**: Create indexes for frequently queried columns
5. **Defaults**: Use meaningful default values

### Query Optimization
1. **Select Specific Fields**: Only select needed columns
2. **Use Indexes**: Ensure queries use indexed columns
3. **Limit Results**: Use LIMIT for large result sets
4. **Avoid N+1**: Use joins instead of multiple queries
5. **Transactions**: Use transactions for related operations

### Migration Safety
1. **Backup**: Always backup before migrations
2. **Test**: Test migrations on staging first
3. **Rollback**: Plan rollback strategies
4. **Atomic**: Keep migrations atomic and reversible
5. **Version**: Use semantic versioning for schema changes

### Type Safety
1. **Generated Types**: Use Drizzle's generated types
2. **Validation**: Validate data before database operations
3. **Inference**: Let TypeScript infer types where possible
4. **Custom Types**: Create custom types for complex queries
5. **Error Handling**: Handle type errors gracefully